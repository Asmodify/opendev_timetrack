# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string    # python -c "import secrets; print(secrets.token_urlsafe(48))"
# Host port the app is published on (localhost only). Pick one free on this server.
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://timetrack:change-me@db:5432/timetrack
POSTGRES_PASSWORD=change-me
COMPANY_NAME=OpenDevelopment
COMPANY_TZ=Asia/Ulaanbaatar
# Public IP address(es) of the office internet connection, comma separated (CIDR allowed).
# Requests from these are tagged "Office", everything else "Remote".
OFFICE_NETWORKS=203.0.113.10/32
# Set true only when a reverse proxy you control (nginx, Caddy, a load balancer) sits in front.
TRUST_PROXY=true
IDLE_TIMEOUT_MINUTES=15
MAX_SHIFT_HOURS=14
# Bump this when the tracking notice text changes; everyone is asked to accept again.
CONSENT_VERSION=2026-10
# Created once on first start if there is no admin yet. Change the password after signing in.
FIRST_ADMIN_EMAIL=hr@example.com
FIRST_ADMIN_PASSWORD=change-me-now
